{
  "name": "snapid",
  "version": "1.0.8",
  "description": "Fast, secure, URL-safe, short unique ID generator for Node.js, browser, and Deno",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest --run",
    "example": "npm run build && node examples/basic.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "snapid",
    "id",
    "keys",
    "url-safe",
    "tinyid",
    "nanoid",
    "uid",
    "uuid",
    "dhiraj kumar"
  ],
  "author": "Dhiraj Kumar",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com"
  },
  "homepage": "https://github.com",
  "bugs": {
    "url": "https://github.com"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  }
}
